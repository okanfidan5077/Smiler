# Copy to .env (git-ignored) and fill in. Used by server/ (pipeline service, migrate, seed) and admin/.

# Supabase: Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Server only. Never put this in the admin page or the app.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase: Project Settings > Database > Connection string (URI, session pooler), with your DB password
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:5432/postgres

# The Supabase Auth user (Authentication > Users) allowed to approve memes
ADMIN_EMAIL=you@example.com

# Optional
# SERVER_PORT=8787
# PIPELINE_CONFIG=gemma
# TRANSLATE_TO=Turkish
# OLLAMA_URL=http://localhost:11434
